# csi.cloudvanguard.io driver (controller + node). Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.csi -t ghcr.io/jchetan26/cloudvanguard-csi:0.4.0 .
# Runtime needs qemu-img (images/snapshots) and mount tools (node plugin).

FROM golang:1.24 AS build
WORKDIR /src
COPY operator-go/go.mod operator-go/go.sum ./
RUN go mod download
COPY operator-go/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/csi-driver ./cmd/csi-driver \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/csictl ./cmd/csictl

FROM ubuntu:24.04
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      qemu-utils e2fsprogs util-linux \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/csi-driver /out/csictl /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/csi-driver"]
