# cloudvanguard-operator (Go). Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.operator -t ghcr.io/jchetan26/cloudvanguard-operator:0.4.0 .

FROM golang:1.24 AS build
WORKDIR /src
COPY operator-go/go.mod operator-go/go.sum ./
RUN go mod download
COPY operator-go/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/manager ./cmd

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
